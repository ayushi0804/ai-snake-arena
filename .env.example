# Copy to .env (never commit .env). All values are optional.
ARENA_ENV=development
ARENA_HOST=127.0.0.1
ARENA_PORT=5000
# SQLite file. Default: data/arena.db
ARENA_DB_PATH=data/arena.db
# Legacy single-integer high score from the original game (imported once, never modified)
ARENA_LEGACY_HIGHSCORE=highscore.txt
# Comma-separated browser origins allowed to call /api from ANOTHER origin. Empty = same-origin only.
ARENA_CORS_ORIGINS=
# Reserved for future sessions/accounts. Set a long random value in production.
ARENA_SECRET_KEY=
